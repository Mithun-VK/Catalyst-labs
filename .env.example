# Catalyst Labs - environment
# Copy to .env.local for development. Never commit a filled-in copy.
# No value here is ever read from client code.

# Canonical origin. Drives canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://catalystlabs.co.in

# ---------------------------------------------------------------------------
# Search engine verification (optional)
#
# Bare tokens only — not the whole <meta> tag. Each is omitted from the HTML
# entirely when unset, because an empty verification tag is worse than none.
# ---------------------------------------------------------------------------

# Google Search Console, "HTML tag" method.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools (msvalidate.01). Covers Bing, Yahoo, DuckDuckGo,
# Ecosia and Copilot. Importing the Google Search Console property into Bing
# verifies automatically and makes this unnecessary.
BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Enquiry delivery
#
# Configure AT LEAST ONE of the two channels below. With neither configured,
# /api/enquiry returns 503 and the form falls back to WhatsApp and email -
# deliberately loud, because a silently dropped lead is the worst outcome.
# ---------------------------------------------------------------------------

# Option A - email via Resend (https://resend.com)
RESEND_API_KEY=
# Must be a verified sender on your Resend domain.
ENQUIRY_FROM_EMAIL=enquiries@catalystlabs.co.in
# Where enquiries land. Defaults to the address in lib/site.ts if unset.
ENQUIRY_TO_EMAIL=

# Option B - POST the enquiry to a CRM, Zapier, n8n or Make webhook.
ENQUIRY_WEBHOOK_URL=
# Sent as the X-Webhook-Secret header so the receiver can verify the caller.
ENQUIRY_WEBHOOK_SECRET=
